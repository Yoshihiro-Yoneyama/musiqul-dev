{
  "name": "musiqul-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsc --noEmit && next dev",
    "dev:fast": "next dev",
    "build": "tsc --noEmit && next build",
    "start": "tsc --noEmit && next start",
    "lint": "eslint . && steiger ./src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:fsd": "steiger ./src"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.7",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-links": "^10.6.8",
    "@storybook/nextjs-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-storybook": "^10.6.8",
    "steiger": "^0.10.0",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.6"
    },
    "tsconfck": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "core-js-pure": false,
    "esbuild": false,
    "unrs-resolver": false
  }
}
